# 📂 Directory where the photos are saved
PHOTO_FOLDER=/workspaces/photobooth-web/photos

# 📁 Allowed photo file extensions (comma-separated)
PHOTO_EXTENSIONS=.jpg,.jpeg,.png

# 🌐 Network settings
HOST=0.0.0.0
PORT=5000

# 🐛 Enable Flask debug mode (True/False)
DEBUG=False

# 🔁 Interval (in seconds) to scan for new photos
SCAN_INTERVAL=2
